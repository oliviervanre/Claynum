<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
    RewriteCond %{HTTP_HOST} !^claynum\.fr$ [NC]
    RewriteRule ^ https://claynum.fr%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html?)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
